.title {
  alignment-x: center;
  text-color: green;
  font-size: 1.5;
  top: 10;
}

.total-boost {
  left: 10;
  top: 30;
  font-size: 1;
}

.average-boosters {
  left: 10;
  top: 45;
  font-size: 0.8;
}

.boosters-per-block {
  left: 10;
  top: 65;
  font-size: 0.8;
}

.container {
  top: 40;
  bottom: 20;
  left: 20;
  width: 70%;
  border: 1;
  border-color: var(--background-color-border);
  background-color: var(--background-color);
  renderer: "PopupWindow";
}

.side-container {
  top: 40;
  bottom: 20;
  width: 22%;
  right: 20;
  border: 1;
  border-color: var(--background-color-border);
  background-color: var(--background-color);
  renderer: "PopupWindow";
}

.booster-grid {
  left: 20;
  top: 50;
  width: 100%;
  padding-right: 10;
  height: fit-content;
  space-between-entries: 10;
  tiles-per-line: 4;
  tile-height: 70;

  Booster {
    border: 1;
    border-color: rgba(255, 255, 85, 0.3);

    .amount {
      left: 5;
      top: 5;
    }

    .icon {
      alignment-x: center;
      alignment-y: center;
      top: 30;
      height: 32;
      width: 32;
    }

    .boost {
      alignment-x: center;
      bottom: 5;
    }

    .date {
      top: 5;
      right: 5;
      font-size: 0.6;
    }

  }

}

Scroll {
   top: 10;
   left: 10;
   right: 0;
   width: 100%;
   height: 90%;

   Scrollbar {
      left: 0;
      top: 0;
      width: 5;
      height: 100%;
      margin-right: 5;
   }
}

.sort-button {
  height: 15;
  left: 10;
  right: 10;
  padding-right: 3;
  top: 10;
}

.clear-button {
  bottom: 10;
  left: 10;
  right: 10;
  height: 15;
}

.export-button {
  bottom: 30;
  left: 10;
  right: 10;
  height: 15;
}