@import super();

.secret-title {
  alignment-x: center;
  text-color: green;
  font-size: 1.5;
  top: 0;
}

.secret-container {
  top: 20;
  bottom: 20;
  left: 20;
  right: 20;
  renderer: "Card";
  background-color: var(--background-color);
  border-color: var(--background-color-border);
  border-radius: var(--border-radius);
  border-thickness: var(--border-thickness);
}

.chat-reconnect-title {
  top: 60;
  left: 50;
  font-size: 1.0;
}

.chat-reconnect-switch {
  top: 60;
  left: 180;
  height: 12;
  width: 25;
}

.chat-all-players-title {
  top: 80;
  left: 50;
  font-size: 1.0;
}

.chat-all-players-switch {
  top: 80;
  left: 230;
  height: 12;
  width: 25;
}